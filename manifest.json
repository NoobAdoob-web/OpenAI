{
  "manifest_version": 3,
  "name": "Saved Library for Instagram",
  "version": "0.1.0",
  "description": "Turn your Instagram saves into a searchable library, then download exactly the posts you choose — media files plus a spreadsheet.",
  "permissions": ["storage", "downloads", "contextMenus", "unlimitedStorage"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Saved Library for Instagram"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/page/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/content/collect.js", "src/content/overlay.js"],
      "css": ["src/content/overlay.css"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

{
  "name": "chatlens",
  "description": "Find messages, find people and chase poll responses in WhatsApp Web. Never sends messages on its own.",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check:no-send": "node scripts/check-no-send.mjs",
    "check:network": "node scripts/check-network.mjs",
    "check": "npm run compile && npm run lint && npm test && npm run build && npm run check:no-send && npm run check:network",
    "postinstall": "wxt prepare",
    "smoke": "node tests/e2e/smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.12.0",
    "playwright": "^1.56.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
